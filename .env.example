# --- Downstream LiteLLM gateway ---
COBAITER_LITELLM_BASE_URL=http://litellm:4000
COBAITER_LITELLM_API_KEY=sk-litellm-master-key

# --- Valkey (mapping table / conversation state) ---
COBAITER_VALKEY_URL=redis://valkey:6379/0

# --- Model registry (externally-managed mapping file) ---
# Path to the hand-managed model registry. Empty = built-in default seed.
COBAITER_MODELS_CONFIG=/app/models.yaml

# --- Routing ---
COBAITER_VIRTUAL_MODEL=cobaiter-auto
COBAITER_CLASSIFIER_MODEL=claude-haiku-4-5
# The classifier emits a tiny JSON verdict; keep reasoning DISABLED on this model
# (e.g. enable_thinking:false) so it does not spend tokens/seconds thinking.
COBAITER_CLASSIFIER_MAX_TOKENS=512
# Max chars of recent conversation shown to the classifier (dominant input-token
# cost / prefill latency). Small is enough to judge difficulty + domain.
COBAITER_CLASSIFIER_DIGEST_CHARS=800
COBAITER_DEFAULT_MODEL=claude-haiku-4-5

# --- Conversation stickiness / hysteresis ---
COBAITER_CONV_TTL_SECONDS=604800
COBAITER_MIN_DWELL_TURNS=3
COBAITER_SWITCH_MARGIN=0.15
COBAITER_SOFT_RECHECK_EVERY=4
COBAITER_SCORE_EMA_ALPHA=0.5

# --- Cost / tier aware selection ---
# effective = suitability - cost_bias*(cost/maxCost) - tier_bias*(tier/maxTier)
# Keep cost_bias > tier_bias ("decide on cost, then tier"). Raise cost_bias to
# lean harder on free/local models; raise tier_bias to prefer lighter variants.
COBAITER_COST_BIAS=0.4
COBAITER_TIER_BIAS=0.1

# --- Credit / availability (sourced from LiteLLM budget/spend) ---
COBAITER_CREDIT_FLOOR=0.0
COBAITER_CREDIT_CACHE_TTL=30

# --- Logging ---
# Level for the "cobaiter" logger: DEBUG / INFO / WARNING / ERROR.
COBAITER_LOG_LEVEL=DEBUG

# --- HTTP server ---
COBAITER_HOST=0.0.0.0
COBAITER_PORT=8000
COBAITER_REQUEST_TIMEOUT=600
