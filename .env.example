# --- Downstream LiteLLM gateway ---
COBAITER_LITELLM_BASE_URL=http://litellm:4000
COBAITER_LITELLM_API_KEY=sk-litellm-master-key

# --- Valkey (mapping table / conversation state) ---
COBAITER_VALKEY_URL=redis://valkey:6379/0

# --- Model registry (externally-managed mapping file) ---
# Path to the hand-managed model registry. Empty = built-in default seed.
COBAITER_MODELS_CONFIG=/app/models.yaml

# --- Difficulty exemplars (externally-managed easy/hard task-phrase sets) ---
# Path to the hand-managed difficulty exemplars used to anchor task difficulty.
# Empty = built-in defaults baked into cobaiter/classifier.py.
COBAITER_DIFFICULTY_EXEMPLARS_CONFIG=/app/difficulty_exemplars.yaml

# --- Routing ---
COBAITER_VIRTUAL_MODEL=cobaiter-auto
# Embedding model served via LiteLLM /v1/embeddings. Relevance = cosine
# similarity between the conversation digest and each model description
# (replaces the old synchronous LLM classifier; description vectors are cached
# in-process). Must be routable by the LiteLLM gateway.
COBAITER_EMBEDDING_MODEL=text-embedding-3-small
# Relevance contrast band: the top candidate maps to 1.0; a candidate whose
# cosine similarity falls this far below the top scores 0.0. Smaller = sharper
# domain separation.
COBAITER_EMBEDDING_REL_BAND=0.01
# Max chars of recent conversation folded into the embedded task digest.
# Small is enough to capture the topic and keeps the embedding call fast.
COBAITER_CLASSIFIER_DIGEST_CHARS=400
# Difficulty anchors (ratio = sim_hard/(sim_hard+sim_easy) on the task digest
# embedding): ratio<=easy_anchor -> difficulty 0.15, ratio>=hard_anchor ->
# difficulty 0.85, linear in between. Model-dependent, like
# COBAITER_EMBEDDING_REL_BAND above — re-measure if the embedding model changes.
COBAITER_DIFFICULTY_EASY_ANCHOR=0.412
COBAITER_DIFFICULTY_HARD_ANCHOR=0.702
COBAITER_DEFAULT_MODEL=claude-haiku-4-5

# --- Conversation stickiness / hysteresis ---
COBAITER_CONV_TTL_SECONDS=604800
COBAITER_MIN_DWELL_TURNS=3
COBAITER_SWITCH_MARGIN=0.15
COBAITER_SOFT_RECHECK_EVERY=4
COBAITER_SCORE_EMA_ALPHA=0.5

# --- Cost / tier aware selection ---
# effective = suitability - cost_bias*(cost/maxCost) - tier_bias*(tier/maxTier)
# Keep cost_bias > tier_bias ("decide on cost, then tier"). Raise cost_bias to
# lean harder on free/local models; raise tier_bias to prefer lighter variants.
COBAITER_COST_BIAS=0.1
COBAITER_TIER_BIAS=0.1
# Capability-fit only considers candidates whose relevance is at least this
# fraction of the top relevance when normalising tier against maxTier, so an
# out-of-domain heavyweight can't inflate maxTier for every in-domain model.
COBAITER_CAPABILITY_REL_FRACTION=0.5
# Exponent applied to difficulty before the capability-fit comparison; >1
# delays the capability penalty at low/mid difficulty.
COBAITER_CAPABILITY_CURVE=1.2

# --- Decision logging (offline recalibration input) ---
# Persist raw classifier signals + the routing decision to Valkey for every
# classifier-driven decision (route classifier-select / context-switch), so
# `cobaiter.calibrate` can later re-derive the difficulty anchors from real
# traffic instead of the one-off manual calibration set.
COBAITER_DECISION_LOG_ENABLED=true
COBAITER_DECISION_LOG_MAXLEN=20000

# --- Offline recalibration (cobaiter.calibrate) ---
# Judge model used to rate a sample of logged task text (0..1 difficulty gold
# labels), separate from any routing model. Required to run `cobaiter-calibrate`.
COBAITER_CALIBRATION_JUDGE_MODEL=
COBAITER_CALIBRATION_SAMPLE_SIZE=200

# --- Credit / availability (sourced from LiteLLM budget/spend) ---
COBAITER_CREDIT_FLOOR=0.0
COBAITER_CREDIT_CACHE_TTL=30

# --- Logging ---
# Level for the "cobaiter" logger: DEBUG / INFO / WARNING / ERROR.
COBAITER_LOG_LEVEL=DEBUG

# --- HTTP server ---
COBAITER_HOST=0.0.0.0
COBAITER_PORT=8000
COBAITER_REQUEST_TIMEOUT=600
